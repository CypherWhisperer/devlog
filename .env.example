# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=DevLog

# ── Database ───────────────────────────────────────────────────────────────────
# These match the devenv.nix MariaDB defaults.
# Change all values before any non-local deployment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devlog
DB_USER=devlog
DB_PASS=devlog
